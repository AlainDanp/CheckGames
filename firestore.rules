rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================

    /// Vérifie si l'utilisateur est un joueur dans la room
    function isPlayerInRoom(roomId) {
      return exists(/databases/$(database)/documents/game_rooms/$(roomId)/players/$(request.auth.uid));
    }

    /// Vérifie si c'est le tour du joueur
    function isPlayerTurn(roomId) {
      return get(/databases/$(database)/documents/game_rooms/$(roomId)).data.currentPlayerId == request.auth.uid;
    }

    /// Vérifie si l'utilisateur est l'hôte de la room
    function isHost(roomId) {
      return get(/databases/$(database)/documents/game_rooms/$(roomId)).data.hostId == request.auth.uid;
    }

    // ============================================================================
    // USERS COLLECTION
    // ============================================================================

    match /users/{userId} {
      // Tout utilisateur authentifié peut créer son propre profil
      allow create: if request.auth != null && request.auth.uid == userId;

      // Seul le propriétaire peut lire et modifier son profil
      allow read, update: if request.auth != null && request.auth.uid == userId;

      // Seul le propriétaire peut supprimer son profil
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================================================
    // GAME ROOMS
    // ============================================================================

    match /game_rooms/{roomId} {
      // Lecture : tout utilisateur authentifié peut voir les rooms (lobby)
      allow read: if request.auth != null;

      // Création : tout utilisateur authentifié peut créer une room
      // L'hôte doit se désigner lui-même
      allow create: if request.auth != null
                    && request.resource.data.hostId == request.auth.uid;

      // Mise à jour : deux cas autorisés
      //   1. Rejoindre la room (l'utilisateur n'est pas encore dans players)
      //      → seuls currentPlayers et updatedAt peuvent changer
      //   2. Joueur déjà dans la room (jeu en cours : passage de tour, effets, etc.)
      //      → l'hôte est un joueur dans la room, isPlayerInRoom() le couvre aussi
      //
      // Note : leaveActiveGame() supprime d'abord players/{id} puis met à jour
      // game_rooms dans la même transaction. Firestore évalue les règles sur l'état
      // AVANT la transaction, donc isPlayerInRoom() retourne encore true. ✓
      allow update: if request.auth != null
                    && (
                      request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['currentPlayers', 'updatedAt'])
                      || isPlayerInRoom(roomId)
                    );

      // Suppression : seulement l'hôte
      allow delete: if request.auth != null && isHost(roomId);

      // ============================================================================
      // PLAYERS SUB-COLLECTION
      // ============================================================================

      match /players/{playerId} {
        // Lecture : tout utilisateur authentifié peut voir la liste des joueurs (lobby)
        allow read: if request.auth != null;

        // Création : seulement soi-même (rejoindre la room)
        allow create: if request.auth != null && request.auth.uid == playerId;

        // Mise à jour : soi-même (isReady, présence) ou l'hôte (handSize, init)
        allow update: if request.auth != null
                      && (request.auth.uid == playerId || isHost(roomId));

        // Suppression : soi-même (quitter) ou l'hôte (fin de partie, expulsion)
        // Note : la Cloud Function utilise admin SDK → bypass cette règle
        allow delete: if request.auth != null
                      && (request.auth.uid == playerId || isHost(roomId));
      }

      // ============================================================================
      // GAME STATE SUB-COLLECTION
      // ============================================================================

      match /game_state/{stateId} {
        // Lecture : uniquement les joueurs de la room
        allow read: if request.auth != null && isPlayerInRoom(roomId);

        // Écriture : uniquement les joueurs de la room (via transactions)
        allow write: if request.auth != null && isPlayerInRoom(roomId);
      }

      // ============================================================================
      // PLAYER HANDS SUB-COLLECTION (PRIVÉ)
      // ============================================================================

      match /player_hands/{playerId} {
        // CRITIQUE : chaque joueur ne voit QUE sa propre main
        allow read: if request.auth != null && request.auth.uid == playerId;

        // Écriture : soi-même (jouer une carte, piocher)
        //         OU l'hôte (distribution initiale via GameMasterService)
        //
        // Si GameActionService permet à un joueur non-hôte d'écrire dans la main
        // d'un autre (redistribution, duel), remplacer isHost() par isPlayerInRoom().
        allow write: if request.auth != null
                     && (request.auth.uid == playerId || isHost(roomId));
      }

      // ============================================================================
      // ACTIONS SUB-COLLECTION (LOG IMMUABLE)
      // ============================================================================

      match /actions/{actionId} {
        // Lecture : les joueurs de la room peuvent voir l'historique
        allow read: if request.auth != null && isPlayerInRoom(roomId);

        // Création : les joueurs peuvent logger leurs propres actions uniquement
        allow create: if request.auth != null
                      && isPlayerInRoom(roomId)
                      && request.resource.data.playerId == request.auth.uid;

        // Log immuable : pas de modification ni de suppression
        allow update, delete: if false;
      }
    }

    // ============================================================================
    // CHAT MESSAGES
    // ============================================================================

    match /chat_messages/{roomId}/messages/{messageId} {
      // Lecture : les joueurs de la room peuvent lire les messages
      allow read: if request.auth != null && isPlayerInRoom(roomId);

      // Création : les joueurs authentifiés peuvent envoyer des messages
      // Le playerId dans le message doit correspondre à l'utilisateur authentifié
      allow create: if request.auth != null
                    && isPlayerInRoom(roomId)
                    && request.resource.data.playerId == request.auth.uid;

      // Messages immuables : pas de modification ni de suppression
      allow update, delete: if false;
    }
  }
}
